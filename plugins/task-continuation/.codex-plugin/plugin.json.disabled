  "keywords": [
    "continuation",
    "quota",
    "scheduling",
    "automation"
  ],
  "skills": "./skills/",
  "interface": {
    "displayName": "Task Continuation",
    "shortDescription": "Resume authorized work after quota recovery",
    "longDescription": "Create or repair continuation schedules with five-hour and weekly quota checks, existing-session routing, execution tracking, and duplicate prevention. Use reset credits only within explicit user authorization and stop on completion or required user action. Includes Codex and Linux systemd guidance; installation alone starts no scheduler.",
    "developerName": "Laxpud",
    "category": "Productivity",
    "capabilities": [
      "Skills"
    ],
    "websiteURL": "https://github.com/Laxpud/my-awesome-vibekits",
    "defaultPrompt": [
      "Use $task-continuation:quota-resume to schedule this authorized task to resume after its five-hour quota recovers, track execution, and stop on completion or required user action."
    ],
    "brandColor": "#2563EB"
  }
}
