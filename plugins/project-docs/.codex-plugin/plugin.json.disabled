{
  "name": "project-docs",
  "version": "2.0.0",
  "description": "Minimal project progress and plan/spec storage, with shared document rules for explicit README, planning, architecture, guidance, and organization workflows.",
  "author": {
    "name": "Laxpud",
    "url": "https://github.com/Laxpud"
